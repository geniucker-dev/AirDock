import { CheckBox, ComboBox, LineEdit, ScrollView, Palette } from "std-widgets.slint";
global Style {
    out property <color> panel:#151922;
    out property <color> card:#1d2330;
    out property <color> text:#edf0f8;
    out property <color> muted:#909bb2;
    out property <color> accent:#8b9dff;
}
component Action inherits Rectangle {
    in property <string> label;
    in property <bool> primary:false;
    in property <bool> enabled:true;
    callback clicked();
    height:38px;border-radius:8px;
    background:primary ? (touch.has-hover ? #a8b5ff : Style.accent) : (touch.has-hover ? #30394d : #242c3c);
    opacity:enabled ? 1 : 0.5;
    Text {text:root.label;color:root.primary ? #101422 : Style.text;font-size:13px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}
    touch:=TouchArea {enabled:root.enabled;mouse-cursor:pointer;clicked=>{root.clicked();}}
}
component Label inherits Text {color:Style.muted;font-size:13px;}
component Heading inherits Text {color:Style.text;font-size:22px;font-weight:700;}
component Nav inherits Rectangle {
    in property <string> label;in property <string> symbol;in property <bool> selected;
    callback clicked();height:44px;border-radius:8px;
    background:root.selected ? #29324b : touch.has-hover ? #202734 : transparent;
    HorizontalLayout {padding-left:14px;spacing:12px;
        Text {text:root.symbol;color:root.selected ? Style.accent : Style.muted;width:24px;vertical-alignment:center;}
        Text {text:root.label;color:root.selected ? Style.text : Style.muted;font-size:14px;vertical-alignment:center;}}
    touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.clicked();}}
}
export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title:"AirPlay-Windows";preferred-width:1120px;preferred-height:760px;min-width:900px;min-height:620px;
    background:transparent;default-font-family:"Segoe UI";default-font-size:14px;
    in-out property <int> page:0;
    in-out property <bool> ui-hidden:false;
    in-out property <bool> connected:false;
    in-out property <bool> video-active:false;
    in-out property <bool> recording:false;
    in-out property <bool> paused:false;
    in-out property <bool> tray-available:false;
    in-out property <string> status:"Ready to connect";
    in-out property <string> device-name:"No device connected";
    in-out property <string> peer:"";
    in-out property <string> codec:"";
    in-out property <string> dimensions:"";
    in-out property <string> decoder:"";
    in-out property <string> stats:"Waiting for a video stream";
    in-out property <string> addresses:"";
    in-out property <string> error:"";
    in-out property <string> usb-status:"No USB device detected";
    in-out property <string> track-title:"Audio streaming";
    in-out property <string> track-artist:"";
    in-out property <string> track-album:"";
    in-out property <string> progress-text:"";
    in-out property <float> progress-ratio:0;
    in-out property <image> cover;
    in-out property <string> recording-path:"";
    in-out property <string> receiver-name:"AirPlay-Windows";
    in-out property <string> resolution-width:"2560";
    in-out property <string> resolution-height:"1440";
    in-out property <string> fps:"60";
    in-out property <string> refresh:"60";
    in-out property <bool> hevc:true;
    in-out property <bool> hardware:false;
    in-out property <bool> vsync:true;
    in-out property <bool> close-tray:true;
    in-out property <bool> minimize-tray:false;
    in-out property <bool> start-hidden:false;
    in-out property <bool> autostart:false;
    in-out property <bool> hls:false;
    in-out property <string> recording-directory:"";
    in-out property <int> recording-codec:0;
    in-out property <int> recording-encoder:0;
    in-out property <string> bitrate:"12";
    out property <length> viewport-x:ui-hidden ? 0px : 246px;
    out property <length> viewport-y:ui-hidden ? 0px : 76px;
    out property <length> viewport-width:ui-hidden ? self.width : self.width - 246px;
    out property <length> viewport-height:ui-hidden ? self.height : self.height - 128px;
    callback disconnect();callback toggle-recording();callback fullscreen();callback hide-ui();callback hide-tray();callback quit();
    callback save-settings();callback reset-settings();callback browse-folder();callback open-folder();callback open-hotspot();callback clear-error();
    if !root.ui-hidden : Rectangle {
        x:0px;y:0px;width:230px;height:parent.height;background:Style.panel;
        VerticalLayout {padding:18px;spacing:8px;
            HorizontalLayout {height:54px;spacing:9px;
                Rectangle {width:36px;height:36px;border-radius:10px;background:Style.accent;Text {text:"▣";color:#161d36;font-size:24px;horizontal-alignment:center;vertical-alignment:center;}}
                VerticalLayout {spacing:2px;Text {text:"AirPlay";color:Style.text;font-size:19px;font-weight:700;}Label {text:"WINDOWS · RUST EDITION";font-size:9px;}}
            }
            Nav {label:"Receiver";symbol:"▣";selected:root.page==0;clicked=>{root.page=0;}}
            Nav {label:"Recording";symbol:"●";selected:root.page==2;clicked=>{root.page=2;}}
            Nav {label:"Settings";symbol:"⚙";selected:root.page==1;clicked=>{root.page=1;}}
            Nav {label:"About & shortcuts";symbol:"ⓘ";selected:root.page==3;clicked=>{root.page=3;}}
            Rectangle {vertical-stretch:1;background:transparent;}
            Rectangle {height:142px;border-radius:10px;background:Style.card;
                VerticalLayout {padding:14px;spacing:8px;
                    Text {text:root.connected ? "CONNECTED DEVICE" : "RECEIVER STATUS";color:Style.muted;font-size:10px;font-weight:700;}
                    Text {text:root.device-name;color:Style.text;font-size:14px;overflow:elide;}
                    Label {text:root.connected ? root.peer : "Listening for AirPlay";overflow:elide;}
                    Label {text:root.usb-status;font-size:11px;overflow:elide;}
                    Action {label:"Disconnect";enabled:root.connected;clicked=>{root.disconnect();}}
                }
            }
            Action {label:"Hide to system tray";enabled:root.tray-available;clicked=>{root.hide-tray();}}
        }
    }
    if !root.ui-hidden : Rectangle {
        x:230px;y:0px;width:parent.width - 230px;height:76px;background:Style.panel;
        HorizontalLayout {padding-left:24px;padding-right:24px;spacing:12px;
            VerticalLayout {padding-top:17px;padding-bottom:17px;
                Text {text:root.page==0 ? "Your screen, on a bigger canvas" : root.page==1 ? "Receiver settings" : root.page==2 ? "Capture your session" : "AirPlay-Windows";font-size:18px;font-weight:600;color:Style.text;}
                Label {text:root.status;font-size:11px;}}
            Rectangle {horizontal-stretch:1;background:transparent;}
            Rectangle {width:112px;background:transparent;Action {y:19px;width:parent.width;label:root.recording ? "■ Stop capture" : "● Record";primary:root.recording;enabled:root.recording||root.video-active;clicked=>{root.toggle-recording();}}}
            Rectangle {width:92px;background:transparent;Action {y:19px;width:parent.width;label:"Fullscreen";clicked=>{root.fullscreen();}}}
            Rectangle {width:76px;background:transparent;Action {y:19px;width:parent.width;label:"Hide UI";clicked=>{root.hide-ui();}}}
        }
    }
    if !root.ui-hidden && root.page==0 && !root.video-active : Rectangle {
        x:root.viewport-x;y:root.viewport-y;width:root.viewport-width;height:root.viewport-height;background:#10141c;
        VerticalLayout {padding:48px;spacing:16px;alignment:center;
            if !root.connected : Text {text:"▣";font-size:72px;color:Style.accent;horizontal-alignment:center;}
            if root.connected && root.cover.width>0 : Image {source:root.cover;height:220px;width:220px;image-fit:contain;}
            Text {text:root.connected ? root.track-title : "Ready when you are";font-size:26px;font-weight:700;color:Style.text;horizontal-alignment:center;}
            Label {text:root.connected ? root.track-artist : "Open Control Center on your iPhone or iPad,\nchoose Screen Mirroring, then select "+root.receiver-name+".";horizontal-alignment:center;wrap:word-wrap;}
            if root.connected && root.track-album!="" : Label {text:root.track-album;horizontal-alignment:center;wrap:word-wrap;}
            if root.connected && root.progress-text!="" : Rectangle {
                height:32px;background:transparent;
                Rectangle {y:0;width:parent.width;height:4px;border-radius:2px;background:Style.card;
                    Rectangle {width:parent.width * root.progress-ratio;height:4px;border-radius:2px;background:Style.accent;}}
                Label {y:12px;width:parent.width;text:root.progress-text;horizontal-alignment:center;font-size:11px;}
            }
            if !root.connected : Rectangle {height:112px;border-radius:12px;background:Style.card;
                VerticalLayout {padding:16px;spacing:8px;
                    Text {text:"Use your local network or Windows hotspot";color:Style.text;font-size:13px;horizontal-alignment:center;}
                    Label {text:root.addresses;font-size:11px;horizontal-alignment:center;wrap:word-wrap;}
                    Action {label:"Open Windows mobile hotspot";clicked=>{root.open-hotspot();}}
                }
            }
            Label {text:root.connected&&root.paused ? "Playback paused" : "";horizontal-alignment:center;}
        }
    }
    if !root.ui-hidden && root.page==1 : Rectangle {
        x:root.viewport-x;y:root.viewport-y;width:root.viewport-width;height:root.viewport-height;background:#10141c;
        ScrollView {VerticalLayout {padding:24px;spacing:15px;
            Heading {text:"Connection & video";}
            Label {text:"Name, resolution and codec changes apply on the next connection.";wrap:word-wrap;}
            Label {text:"Receiver name";}LineEdit {text<=>root.receiver-name;}
            HorizontalLayout {spacing:12px;
                VerticalLayout {Label {text:"Width";}LineEdit {text<=>root.resolution-width;input-type:number;}}
                VerticalLayout {Label {text:"Height";}LineEdit {text<=>root.resolution-height;input-type:number;}}
                VerticalLayout {Label {text:"Maximum FPS";}LineEdit {text<=>root.fps;input-type:number;}}
                VerticalLayout {Label {text:"Refresh rate";}LineEdit {text<=>root.refresh;input-type:number;}}}
            CheckBox {text:"Allow HEVC mirroring";checked<=>root.hevc;}
            CheckBox {text:"Hardware decoding (NVDEC / D3D11VA / CPU fallback)";checked<=>root.hardware;}
            CheckBox {text:"Synchronize presentation with the display (VSync)";checked<=>root.vsync;}
            Heading {text:"Desktop behavior";}
            CheckBox {text:"Close window to the system tray";checked<=>root.close-tray;enabled:root.tray-available;}
            CheckBox {text:"Minimize to the system tray";checked<=>root.minimize-tray;enabled:root.tray-available;}
            CheckBox {text:"Start hidden in the tray";checked<=>root.start-hidden;enabled:root.tray-available;}
            CheckBox {text:"Start with Windows";checked<=>root.autostart;enabled:root.tray-available;}
            Heading {text:"Experimental streaming";}
            CheckBox {text:"Enable HLS playback (unprotected content only)";checked<=>root.hls;}
            HorizontalLayout {spacing:12px;Action {label:"Save settings";primary:true;clicked=>{root.save-settings();}}Action {label:"Restore defaults";clicked=>{root.reset-settings();}}}
        }}
    }
    if !root.ui-hidden && root.page==2 : Rectangle {
        x:root.viewport-x;y:root.viewport-y;width:root.viewport-width;height:root.viewport-height;background:#10141c;
        VerticalLayout {padding:30px;spacing:18px;
            Heading {text:"Record video and audio together";}
            Label {text:"Capture is saved as an MP4. You can hide this window while recording.";wrap:word-wrap;}
            Label {text:"Save directory";}LineEdit {text<=>root.recording-directory;}
            HorizontalLayout {spacing:12px;Action {label:"Choose folder…";clicked=>{root.browse-folder();}}Action {label:"Open folder";clicked=>{root.open-folder();}}}
            HorizontalLayout {spacing:14px;
                VerticalLayout {Label {text:"Video codec";}ComboBox {model:["H.264","HEVC"];current-index<=>root.recording-codec;}}
                VerticalLayout {Label {text:"Encoder";}ComboBox {model:["Automatic","GPU only","CPU only"];current-index<=>root.recording-encoder;}}
                VerticalLayout {Label {text:"Bitrate (2–40 Mbps)";}LineEdit {text<=>root.bitrate;input-type:number;}}}
            Action {label:"Save recording preferences";clicked=>{root.save-settings();}}
            Rectangle {height:140px;border-radius:12px;background:Style.card;
                VerticalLayout {padding:20px;spacing:12px;
                    Text {text:root.recording ? "● Recording in progress" : "Ready to capture";color:root.recording ? #ff8b99 : Style.text;font-size:18px;font-weight:600;}
                    Label {text:root.recording-path=="" ? "Connect a device and start screen mirroring to record." : root.recording-path;wrap:word-wrap;}
                    Action {label:root.recording ? "Stop and finalize MP4" : "Start recording";primary:true;enabled:root.recording||root.video-active;clicked=>{root.toggle-recording();}}}
            }
            Rectangle {vertical-stretch:1;background:transparent;}
        }
    }
    if !root.ui-hidden && root.page==3 : Rectangle {
        x:root.viewport-x;y:root.viewport-y;width:root.viewport-width;height:root.viewport-height;background:#10141c;
        VerticalLayout {padding:36px;spacing:18px;
            Heading {text:"A native receiver, rebuilt in Rust";}
            Label {text:"Slint interface · FFmpeg media · SDL presentation\nGPL-3.0-or-later · experimental Rust branch";wrap:word-wrap;}
            Text {text:"Keyboard shortcuts";color:Style.text;font-size:18px;font-weight:600;}
            Label {text:"F11              Fullscreen\nCtrl + H      Show / hide interface\nCtrl + R      Start / stop recording\nCtrl + D      Disconnect device\nEscape        Leave fullscreen / show interface";}
            Text {text:"Performance acceptance";color:Style.text;font-size:18px;font-weight:600;}
            Label {text:"Shown FPS counts newly presented video frames. Hardware parity requires paired Windows / iPhone tests against the C++ release; see docs/RUST_ACCEPTANCE.md.";wrap:word-wrap;}
            Rectangle {vertical-stretch:1;background:transparent;}
            Action {label:"Quit receiver";clicked=>{root.quit();}}}
    }
    if !root.ui-hidden : Rectangle {
        x:230px;y:parent.height - 52px;width:parent.width - 230px;height:52px;background:Style.panel;
        HorizontalLayout {padding:18px;spacing:12px;
            Text {text:root.connected ? "●" : "○";color:root.connected ? #6dd8b0 : Style.muted;width:16px;vertical-alignment:center;}
            Label {text:root.stats;font-size:11px;vertical-alignment:center;overflow:elide;}
            Label {text:root.codec+"  "+root.dimensions+"  "+root.decoder;font-size:11px;vertical-alignment:center;horizontal-alignment:right;overflow:elide;}}}
    if root.error!="" && !root.ui-hidden : Rectangle {
        x:246px;y:84px;width:parent.width - 262px;height:64px;border-radius:10px;background:#522b38;
        HorizontalLayout {padding:12px;spacing:12px;Text {text:root.error;color:#ffe0e4;wrap:word-wrap;}Action {width:66px;label:"Dismiss";clicked=>{root.clear-error();}}}}
}
